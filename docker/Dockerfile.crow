# =============================================================================
# Crow (C++) backend — multi-stage build
# Stage 1: build with vcpkg + CMake
# Stage 2: minimal runtime image
# =============================================================================

# ── Build stage ──────────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    zip \
    unzip \
    tar \
    pkg-config \
    libpq-dev \
    libpqxx-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install vcpkg (pinned to a stable tag)
RUN git clone https://github.com/microsoft/vcpkg /vcpkg --depth 1 --branch 2024.11.16 \
    && /vcpkg/bootstrap-vcpkg.sh -disableMetrics

ENV VCPKG_ROOT=/vcpkg

WORKDIR /build
COPY backend/ .

# Configure and build
RUN cmake -B cmake-build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/vcpkg/scripts/buildsystems/vcpkg.cmake \
    && cmake --build cmake-build --config Release -j$(nproc) \
    && ctest --test-dir cmake-build --output-on-failure

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    libpq5 \
    libpqxx-6.4 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/cmake-build/TrafficManagementBackend /usr/local/bin/traffic-backend

EXPOSE 8080

CMD ["traffic-backend"]
